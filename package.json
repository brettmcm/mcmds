{
  "name": "@brettmcm/mcmds",
  "version": "0.3.1",
  "description": "A restrained, compact React product interface system derived from Ledger and Scope.",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/brettmcm/mcmds.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com", "access": "restricted" },
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens": { "types": "./dist/tokens.d.ts", "import": "./dist/tokens.js" },
    "./manifest": "./dist/component-manifest.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit": "node scripts/audit-mcmds.mjs",
    "check": "npm run check:generated && npm run typecheck && npm test && npm run build",
    "prepack": "npm run check",
    "release": "changeset publish",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "peerDependencies": { "react": ">=18.2", "react-dom": ">=18.2" },
  "dependencies": {
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-radio-group": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-tabs": "latest",
    "cmdk": "latest",
    "sonner": "latest",
    "vaul": "latest"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@figma/code-connect": "latest",
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-vitest": "latest",
    "@storybook/react-vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
